# Local Docker PostgreSQL example only; replace DATABASE_URL for production.
ORGANY_RUNTIME=db
DATABASE_URL=postgres://organy_app:organy_app@localhost:5432/organy_app

# Placeholder only. Replace with a random secret of at least 32 characters.
BETTER_AUTH_SECRET=replace-me-with-random-secret-at-least-32-characters

# Loopback HTTP is allowed for local development; public production URLs must use HTTPS.
BETTER_AUTH_URL=http://localhost:3000
# Congregation registration requires a Resend API key and verified-domain sender.
CONGREGATION_BASE_URL=http://localhost:3000
CONGREGATION_EMAIL_FROM=Organy App <preferences@example.invalid>
RESEND_API_KEY=replace-me-with-resend-api-key
# Independent HMAC/session secret; replace with a random value of at least 32 characters.
CONGREGATION_SECURITY_SECRET=replace-me-with-random-secret-at-least-32-characters
